# ============================================================
# L4D2 管理面板配置文件
# 使用方法：复制本文件为 .env（项目根目录），修改后保存
# ============================================================

# 面板登录账号（务必修改默认值）
PANEL_USER=admin
PANEL_PASSWORD=please-change-me

# 会话签名密钥（必填，否则重启后所有登录失效；可用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=please-change-me-to-a-long-random-string

# 可选：Steam 账号（用于服务端下载登录；不填则使用匿名下载）
#STEAM_USER=
#STEAM_PASSWORD=

# 可选：面板监听端口（默认 8080；与其他服务冲突时可修改，也可在 manage.sh "配置面板信息" 中设置）
#PANEL_PORT=8080

# 可选：A2S 玩家查询目标地址。留空 = 自动（先查 127.0.0.1，超时自动换本机内网 IP
# 重试——部分服务器环境会丢弃回环 UDP 查询）；面板与游戏服分机部署时填游戏服务器 IP
#A2S_HOST=

# 可选：服务端安装目录（默认 /home/steam/l4d2server，目录不存在会自动创建）
#SERVER_ROOT=/home/steam/l4d2server

# 可选：SteamCMD 安装目录（默认 /home/steam/steamcmd）
#STEAMCMD_DIR=/home/steam/steamcmd
